# ============================================================
#  Bus Video - configuracao do SERVIDOR DA GARAGEM
#  Arquivo: /opt/busvideo-server/config/server.env  (permissao 600)
#  Nunca coloque estes valores no codigo. Gere os segredos com:
#     /opt/busvideo-server/venv/bin/python -m busvideo_server.tools gen-env
# ============================================================

# --- Rede -----------------------------------------------------
# Interface/porta em que o servidor escuta. 0.0.0.0 = todas as interfaces da LAN.
BUSVIDEO_HOST=0.0.0.0
# Porta de escuta. Com HTTPS use 443 (o unit systemd ja permite portas baixas). Sem HTTPS, 8080.
BUSVIDEO_PORT=443

# --- HTTPS (recomendado; o install_server.sh gera os arquivos) ---
# Certificado e chave do servidor emitidos pela CA da garagem (python -m busvideo_server.tools gen-cert --out .../tls).
# Com os dois preenchidos o servidor so fala HTTPS. O ca.crt da mesma pasta vai para cada onibus (CA_CERT)
# e pode ser instalado nos PCs/celulares dos operadores para o navegador nao avisar.
BUSVIDEO_TLS_CERT=/opt/busvideo-server/config/tls/server.crt
BUSVIDEO_TLS_KEY=/opt/busvideo-server/config/tls/server.key
# Porta HTTP auxiliar: so redireciona para HTTPS e entrega /ca.crt. 0 = desligada.
BUSVIDEO_HTTP_REDIRECT_PORT=80

# --- Caminhos -------------------------------------------------
BUSVIDEO_DATA_DIR=/opt/busvideo-server/data
BUSVIDEO_LOG_DIR=/opt/busvideo-server/logs

# --- Identidade / marca (ajustar para a operadora compradora) --
PRODUCT_NAME=Bus Video
COMPANY_NAME=Empresa Exemplo

# --- Contas do painel (interface web) --------------------------
# Duas contas: o OPERADOR (uso diario: publica video, acompanha a frota) e o ADMINISTRADOR (suporte: tudo
# isso e ainda redefine a senha do operador pelo painel). Os hashes aqui so SEMEIAM o banco na primeira
# subida; depois que uma senha e trocada pelo painel ou por `tools set-password`, o banco prevalece.
OPERATOR_USER=operador
# Hash PBKDF2 gerado por: python -m busvideo_server.tools hash-password
OPERATOR_PASSWORD_HASH=
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Chave para assinar o cookie de sessao (gen-token). Se vazia, sessoes caem a cada reinicio.
SECRET_KEY=
# Validade da sessao em segundos (padrao 12h)
SESSION_TTL_S=43200

# --- Autenticacao dos onibus (Raspberry Pi) -------------------
# Token compartilhado; deve ser IGUAL ao DEVICE_TOKEN do client.env de cada onibus.
DEVICE_TOKEN=
# Onibus sem heartbeat ha mais que isto (s) aparece como "Offline" (padrao 15 min)
OFFLINE_AFTER_S=900

# --- Ferramentas ----------------------------------------------
FFPROBE_BIN=ffprobe

# --- Politica de midia (limites do decodificador do Raspberry Pi 3B+) ---
MEDIA_ALLOWED_EXTENSIONS=mp4,m4v,mov
MEDIA_ALLOWED_VIDEO_CODECS=h264
# "none" = video sem trilha de audio tambem e aceito
MEDIA_ALLOWED_AUDIO_CODECS=aac,none
MEDIA_MAX_WIDTH=1920
MEDIA_MAX_HEIGHT=1080
MEDIA_MAX_FPS=30
# Level H.264 x10 (41 = 4.1). O Pi 3B+ decodifica ate 1080p30.
MEDIA_MAX_H264_LEVEL=41
MEDIA_MAX_BITRATE_KBPS=12000
# Duracao maxima em segundos (3600 = 60 min)
MEDIA_MAX_DURATION_S=3600
# Tamanho maximo do arquivo em MB
MEDIA_MAX_SIZE_MB=2048
