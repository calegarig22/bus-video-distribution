[Unit]
Description=Bus Video - boot provisioning (busvideo-provision.txt on the boot partition)
DefaultDependencies=no
After=local-fs.target
Before=busvideo-sync.service busvideo-player.service network-pre.target
ConditionPathExists=/opt/busvideo-player/config/client.env

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/busvideo-player/scripts/provision.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
