# ============================================================
#  Bus Video - configuracao do TERMINAL EMBARCADO (Raspberry Pi)
#  Arquivo: /opt/busvideo-player/config/client.env  (permissao 640, dono busvideo)
#  Preenchido pelo install_client.sh. Sem senhas no codigo.
# ============================================================

# --- Identidade -----------------------------------------------
# Identificador unico do onibus (letras, numeros, - e _). Ex.: BUS-001
DEVICE_ID=BUS-001

# --- Servidor da garagem --------------------------------------
# Lista em ordem de tentativa, separada por virgula: IP fixo, hostname DNS, mDNS.
SERVER_URLS=https://192.168.100.10,https://busvideo-server.local
# Token IGUAL ao DEVICE_TOKEN do server.env (impresso pelo install_server.sh)
DEVICE_TOKEN=
# Certificado da CA da garagem (ca.crt copiado do servidor). Com HTTPS e obrigatorio: o onibus
# so aceita o servidor assinado por esta CA. Preenchido por install_client.sh --ca-cert.
CA_CERT=/opt/busvideo-player/config/ca.crt
# Aceitar servidor http:// (sem certificado). NUNCA em producao: o token seria entregue a qualquer
# rede que se passe pela garagem. So para demo/bancada.
ALLOW_INSECURE_HTTP=false

# --- Caminhos -------------------------------------------------
BASE_DIR=/opt/busvideo-player

# --- Sincronizacao --------------------------------------------
# Intervalo entre consultas ao servidor (s)
SYNC_INTERVAL=60
# Sem rede (na rua): checagem local a cada N s, sem trafego, para reagir em segundos ao estacionar na vaga
NETWORK_CHECK_INTERVAL=5
# Com rede mas sem resposta do servidor: espera maxima entre tentativas (s)
MAX_BACKOFF=60
# Mensagens nas telas do onibus durante a atualizacao ('Recebendo video... 45%', 'Atualizado, pode sair')
OSD_MESSAGES=true
# Versoes mantidas em disco (atual + anteriores para rollback). Minimo 1.
KEEP_VERSIONS=2
# Margem de espaco livre exigida alem do tamanho do video (MB)
DISK_MARGIN_MB=300
# Timeouts HTTP (s): download/consultas e verificacao /api/health
HTTP_TIMEOUT=30
HEALTH_TIMEOUT=3
# Limite de velocidade do download em Mbps (0 = sem limite)
DOWNLOAD_RATE_LIMIT_MBPS=0
# Tamanho do bloco de gravacao (bytes). 1 MiB reduz escritas no cartao SD.
CHUNK_SIZE=1048576
# Validacao de formato apos o download: auto | ffprobe | mpv | off
VALIDATE_FORMAT=auto
# Apos N falhas na mesma versao, aguarda FAILURE_COOLDOWN_S antes de tentar de novo
MAX_FAILURES_PER_VERSION=3
FAILURE_COOLDOWN_S=1800
# Ajustar o relogio pelo servidor (Pi nao tem RTC). Exige CAP_SYS_TIME no busvideo-sync.service.
SET_TIME_FROM_SERVER=false

# --- Player ---------------------------------------------------
# mpv (producao no Pi) | fake (simulado, testes/demo) | mpv-desktop (demo em notebook)
PLAYER=mpv
# Quando aplicar o novo video: end_of_loop (no fim da repeticao atual) | immediate
SWITCH_MODE=end_of_loop
# Espera maxima pelo fim do loop (s). 0 = duracao do video + 60 s
SWITCH_MAX_WAIT_S=0
# Audio: off | alsa | auto
AUDIO=off
# Argumentos extras para o mpv (ex.: --hwdec=none para teste sem aceleracao)
MPV_EXTRA_ARGS=

# --- Logs -----------------------------------------------------
LOG_LEVEL=INFO
# Sobrescreve o hostname informado ao servidor (vazio = hostname do sistema)
HOSTNAME_OVERRIDE=

# --- Wi-Fi da garagem -----------------------------------------
# Usados APENAS por install_client.sh / scripts/wifi-setup.sh; a aplicacao nao os le.
# A conexao e gerenciada pelo sistema (NetworkManager ou netplan/wpa_supplicant).
WIFI_SSID=GARAGEM_EXEMPLO
WIFI_PSK=
WIFI_IFACE=wlan0
